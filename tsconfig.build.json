{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    // Node16 resolves to CommonJS here because package.json has no
    // "type": "module", which keeps `main` loadable by Node-based tooling.
    // Metro and bundlers read `react-native` / `source` and compile src instead.
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["react-native"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "example", "**/*.test.ts", "**/*.test.tsx", "src/__tests__"]
}

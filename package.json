{
  "name": "number-flow-native",
  "version": "0.1.0",
  "description": "An animated number component for React Native and Expo. A recreation of NumberFlow.",
  "license": "MIT",
  "author": "Ardit Xhaferi",
  "keywords": [
    "react-native",
    "expo",
    "number-flow",
    "odometer",
    "animated-number",
    "number-animation",
    "number-format",
    "reanimated"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf lib coverage",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@react-native-masked-view/masked-view": ">=0.3.0",
    "expo-linear-gradient": ">=13.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-reanimated": ">=3.6.0"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-linear-gradient": "~57.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haxhibekaj/number-flow-native.git"
  },
  "bugs": {
    "url": "https://github.com/haxhibekaj/number-flow-native/issues"
  },
  "homepage": "https://github.com/haxhibekaj/number-flow-native#readme"
}
